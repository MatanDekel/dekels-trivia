rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() { return request.auth != null; }
    // must match ADMIN_EMAIL in src/backend/admin.js
    function isAdmin() { return signedIn() && request.auth.token.email == 'admin@dekel-trivia.app'; }

    match /scores/{id} {
      allow read: if signedIn() && (resource.data.private == false || isAdmin());
      allow create: if signedIn()
        && request.resource.data.name is string && request.resource.data.name.size() > 0 && request.resource.data.name.size() <= 20
        && request.resource.data.category is string
        && request.resource.data.score is int && request.resource.data.score >= 0 && request.resource.data.score <= 2000
        && request.resource.data.correct is int && request.resource.data.total is int
        && (request.resource.data.private == false || isAdmin());
      allow update: if false;
      allow delete: if isAdmin();
    }

    match /categories/{id} {
      allow read: if resource.data.hidden == false || isAdmin();
      allow write: if isAdmin();
    }
  }
}
